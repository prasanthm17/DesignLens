# SQLite file used by DesignLens
DATABASE_URL=./data/designlens.db

# HTTP port
PORT=8080

# Sign session cookies with a long random string in any shared environment
SESSION_SECRET=replace-with-a-long-random-string

# Development only: allow auditing localhost / private network targets
# ALLOW_PRIVATE_TARGETS=1

# Skip warming the demo workspace at boot
# SKIP_DEMO_SEED=1
